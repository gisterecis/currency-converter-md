{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "from manifest.json",
  "description": "__MSG_extDescription__",
  "default_locale": "ro",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["contextMenus", "storage", "scripting", "notifications", "activeTab"],
  "host_permissions": [
    "https://*.maib.md/*",
    "https://*.micb.md/*",
    "https://*.victoriabank.md/*",
    "https://*.otpbank.md/*",
    "https://*.procreditbank.md/*",
    "https://*.fincombank.com/*",
    "https://*.eximbank.md/*",
    "https://*.energbank.com/*",
    "https://*.comertbank.md/*",
    "https://*.ecb.md/*",
    "https://*.bnm.md/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  }
}
