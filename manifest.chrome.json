{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "from manifest.json",
  "description": "__MSG_extDescription__",
  "default_locale": "ro",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["contextMenus", "storage", "scripting", "notifications", "activeTab"],
  "host_permissions": [
    "https://www.maib.md/*",
    "https://micb.md/*",
    "https://www.victoriabank.md/*",
    "https://www.otpbank.md/*",
    "https://procreditbank.md/*",
    "https://fincombank.com/*",
    "https://eximbank.md/*",
    "https://www.energbank.com/*",
    "https://comertbank.md/*",
    "https://www.ecb.md/*",
    "https://www.bnm.md/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "convert-selection": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "__MSG_cmdConvert__"
    }
  }
}
