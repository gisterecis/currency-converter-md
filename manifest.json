{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.0.1",
  "description": "__MSG_extDescription__",
  "default_locale": "ro",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["menus", "storage", "scripting", "notifications", "activeTab"],
  "host_permissions": [
    "https://www.maib.md/*",
    "https://micb.md/*",
    "https://www.victoriabank.md/*",
    "https://www.otpbank.md/*",
    "https://procreditbank.md/*",
    "https://fincombank.com/*",
    "https://eximbank.md/*",
    "https://www.energbank.com/*",
    "https://comertbank.md/*",
    "https://www.ecb.md/*",
    "https://www.bnm.md/*"
  ],
  "background": {
    "scripts": [
      "lib/ext.js",
      "lib/i18n.js",
      "lib/scrape.js",
      "lib/parse.js",
      "lib/convert.js",
      "lib/banks/registry.js",
      "lib/banks/maib.js",
      "lib/banks/micb.js",
      "lib/banks/victoriabank.js",
      "lib/banks/otp.js",
      "lib/banks/procredit.js",
      "lib/banks/fincombank.js",
      "lib/banks/eximbank.js",
      "lib/banks/energbank.js",
      "lib/banks/comertbank.js",
      "lib/banks/ecb.js",
      "lib/banks/bnm.js",
      "lib/rates.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "convert-selection": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "__MSG_cmdConvert__"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "maib-currency-converter@gisterecis",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
