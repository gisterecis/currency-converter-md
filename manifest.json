{
  "manifest_version": 3,
  "name": "Currency Converter (maib rates)",
  "version": "1.0.0",
  "description": "Select an amount, right-click and convert it at maib.md exchange rates (cash at branches and card operations).",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["menus", "storage", "scripting", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["lib/parse.js", "lib/convert.js", "lib/rates.js", "background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "maib-currency-converter@gisterecis",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
