{
  "name": "convertor-valutar-md",
  "version": "2.0.2",
  "private": true,
  "license": "MIT",
  "description": "Browser extension for Firefox and Chrome: convert selected amounts at Moldovan banks' exchange rates",
  "scripts": {
    "test": "node --test",
    "check-banks": "node scripts/check-banks.mjs",
    "e2e": "node tests/e2e/run.mjs",
    "e2e:chrome": "node scripts/build.mjs && node tests/e2e/chrome.mjs",
    "lint": "web-ext lint",
    "build": "npm run build:firefox && npm run build:chrome",
    "build:firefox": "web-ext build --overwrite-dest --filename convertor-valutar-md-firefox-{version}.xpi",
    "build:chrome": "node scripts/build.mjs && web-ext build --source-dir dist/chrome --overwrite-dest --filename convertor-valutar-md-chrome-{version}.zip",
    "package": "bash scripts/package.sh",
    "start": "web-ext run --firefox=${FIREFOX:-firefox} --start-url tests/manual.html",
    "start:chrome": "node scripts/build.mjs && web-ext run --target chromium --chromium-binary=${CHROMIUM:-chromium} --source-dir dist/chrome",
    "start:android": "web-ext run --target firefox-android --android-device=${ANDROID_DEVICE:-} --firefox-apk=${FIREFOX_APK:-org.mozilla.firefox}",
    "store:screenshots": "node scripts/build.mjs && node tests/e2e/chrome.mjs --store",
    "sign": "web-ext sign --channel=unlisted"
  },
  "webExt": {
    "ignoreFiles": [
      "tests",
      "scripts",
      "store",
      "dist",
      "release",
      "manifest.chrome.json",
      "node_modules",
      "package.json",
      "package-lock.json",
      "README.md",
      "SECURITY.md",
      "web-ext-artifacts",
      "icons/icon.svg"
    ]
  },
  "devDependencies": {
    "web-ext": "^10.8.0"
  }
}
